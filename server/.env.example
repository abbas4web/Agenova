# ── Server ──────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ── Database ─────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:password@localhost:5432/agentora

# ── Auth ─────────────────────────────────────────────────
JWT_SECRET=change_this_to_a_long_random_secret_at_least_32_chars
JWT_EXPIRES_IN=7d

# ── AI Provider ───────────────────────────────────────────
# Choose one: "openrouter" | "gemini" | "groq"
#
# RECOMMENDATION: Use "openrouter" for the best free-tier experience.
# OpenRouter gives access to 200+ models including free Llama, Gemini, Mistral.
# Get your key at: https://openrouter.ai/keys  (free, no credit card needed)
#
AI_PROVIDER=openrouter

# ── OpenRouter (recommended) ──────────────────────────────
# Key format: sk-or-v1-...
# Get key:    https://openrouter.ai/keys
#
# Free models (no credits needed, just set the model ID below):
#   meta-llama/llama-3.3-70b-instruct:free   ← best quality free model
#   meta-llama/llama-3.1-8b-instruct:free    ← fastest free model
#   meta-llama/llama-3.2-3b-instruct:free    ← ultra fast, lower quality
#   mistralai/mistral-7b-instruct:free
#   google/gemma-2-9b-it:free
#   google/gemma-3-4b-it:free
#   qwen/qwen-2-7b-instruct:free
#   deepseek/deepseek-r1:free                ← reasoning model
#
# Paid models (require credits, higher quality/limits):
#   openai/gpt-4o
#   anthropic/claude-3.5-sonnet
#   google/gemini-pro-1.5
#   meta-llama/llama-3.1-405b-instruct
#
OPENROUTER_API_KEY=sk-or-v1-your_key_here
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# ── Gemini (Google AI Studio) ─────────────────────────────
# Key format: AIzaSy...  (NOT AQ. keys — those are Vertex AI OAuth tokens)
# Get key:    https://aistudio.google.com/app/apikey
#
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# ── Groq ─────────────────────────────────────────────────
# Key format: gsk_...
# Get key:    https://console.groq.com/keys
#
# Available models (vary by plan — check https://console.groq.com/docs/models):
#   llama-3.1-8b-instant      ← free tier
#   llama-3.3-70b-versatile   ← enterprise
#   openai/gpt-oss-20b        ← available on most plans
#
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# ── Rate Limiting ─────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=60
